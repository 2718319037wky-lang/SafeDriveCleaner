    "ehthumbs.db",
    "IconCache.db"
  ],

  "_extExceptionsNote": [
    "neverTouchExtensions 里保护了 .db（怕误删数据库），但 Thumbs.db / ehthumbs.db / IconCache.db",
    "是 Windows 缩略图与图标缓存，扩展名同样是 .db，会被误伤，导致缩略图规则永远不生效。",
    "这里做的是「文件名级」例外，不是「规则级」绕过：",
    "  - 只按完整文件名精确匹配，支持不了通配符，无法被规则间接利用；",
    "  - 其余三道拦截（路径 / 目录名 / 路径段）依然全部生效；",
    "  - 例外文件仍必须被某条白名单规则显式命中，才可能成为候选。"
  ],

  "pruneDirectoryNames": [
    "System Volume Information",
    "$RECYCLE.BIN",
    "$SysReset",
    "Recovery",
    "Boot",
    "EFI",
    "Windows",
